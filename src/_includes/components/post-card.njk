{% from "components/tag.njk" import tagList %}

{% macro postCard(post, locale, index) %}
{% set delay = (index or 0) * 40 %}
<article class="post-card" style="animation-delay: {{ delay }}ms">
  {% if post.data.cover %}
  <a class="post-card__cover" href="{{ post.url }}" tabindex="-1" aria-hidden="true">
    <img src="{{ post.data.cover }}" alt="" width="640" height="360" loading="lazy" decoding="async">
  </a>
  {% endif %}

  <div class="post-card__body">
    <h3 class="post-card__title"><a href="{{ post.url }}">{{ post.data.title }}</a></h3>

    <p class="post-card__meta">
      <time datetime="{{ post.date | dateToISO }}">{{ post.date | dateFormat(locale.id) }}</time>
    </p>

    {% if post.data.description %}
    <p class="post-card__excerpt">{{ post.data.description }}</p>
    {% endif %}

    {% if post.data.tags %}
    <div class="post-card__tags">{{ tagList(post.data.tags, locale) }}</div>
    {% endif %}
  </div>
</article>
{% endmacro %}
