<footer class="site-footer">
  <div class="container">
    <div class="footer__inner">
      <div class="footer__brand">
        <p class="footer__brand-name">{{ ui.site.name }}</p>
        <p class="footer__tagline">{{ ui.site.tagline }}</p>
      <p id="someInfo" style="margin: 0"></p>
      </div>

      <nav class="footer__nav" aria-label="{{ ui.footer.nav }}">
        {% for item in site.navigation %}
          <a href="{{ item.url | localeUrl(locale) }}">{{ ui.nav[item.key] }}</a>
        {% endfor %}
      </nav>

      <nav class="footer__nav" aria-label="{{ ui.footer.contact }}">
        <a href="{{ '/contact/' | localeUrl(locale) }}">{{ ui.nav.contact }}</a>
        <a href="{{ '/rss/' | localeUrl(locale) }}">RSS</a>
        <a href="/sitemap.xml">Sitemap</a>
        <a href="https://github.com/{{ site.repo }}" target="_blank" rel="noopener">GitHub</a>
      </nav>
    </div>

    <div class="footer__legal">
      <noscript>
        <p class="footer__noscript">{{ 'browser.noscript' | t(locale.id) }}</p>
      </noscript>
      <p>主办单位：韵典综合平台运营中心　举报电话：0712-5253195　举报邮箱：aeyundian@163.com</p>
      <p>反诈劝阻电话 962110：如接到来电，请立即接听，避免财产损失。</p>
      <p>
        <a href="http://icp.gov.moe/?keyword=20263044" target="_blank" rel="noopener">萌ICP备20263044号</a>
        　技术支持：韵典　© 2026 {{ site.author }}. {{ ui.footer.rights }}
      </p>
      <div class="footer__badges">
        <a href="http://www.shjbzx.cn/" target="_blank" rel="noopener"><img src="/assets/images/footer-shfb.png" alt="上海市互联网违法和不良信息举报中心" width="121" height="48" loading="lazy"></a>
        <a href="http://www.12377.cn/" target="_blank" rel="noopener"><img src="/assets/images/footer-jubao.png" alt="网上有害信息举报专区" width="121" height="48" loading="lazy"></a>
        <img src="/assets/images/footer-962110.png" alt="962110 反诈劝阻电话" width="121" height="48" loading="lazy">
      </div>
    </div>
  </div>
</footer>
<script>
(function() {
    var elFooterP = document.getElementById("someInfo");

    function checkTimeAndUpdate() {
        if (!elFooterP) return;

        var now = new Date();
        var month = now.getMonth();
        var day = now.getDate();
        var hours = now.getHours();
        var minutes = now.getMinutes();

        var isSpecial =  (month === 4 && day === 20) ||
                        (month === 10 && day === 12) ||
                        (hours === 5 && minutes === 20) ||
                        (hours === 11 && minutes === 12) ||
                        (hours === 13 && minutes === 14);

        if (isSpecial) {
            if (elFooterP.textContent !== "万康驰我爱你！") {
                elFooterP.textContent = "万康驰我爱你！";
                elFooterP.style.color = "#FF5555";
            }
        } else {
            if (elFooterP.textContent !== "") {
                elFooterP.textContent = "";
                elFooterP.style.color = "";
            }
        }
    }

    setTimeout(checkTimeAndUpdate, 100);
    setInterval(checkTimeAndUpdate, 30000);

    var hidden, visibilityChange;
    if (typeof document.hidden !== "undefined") {
        hidden = "hidden";
        visibilityChange = "visibilitychange";
    } else if (typeof document.msHidden !== "undefined") {
        hidden = "msHidden";
        visibilityChange = "msvisibilitychange";
    } else if (typeof document.webkitHidden !== "undefined") {
        hidden = "webkitHidden";
        visibilityChange = "webkitvisibilitychange";
    }

    if (typeof document.addEventListener !== "undefined" && typeof hidden !== "undefined") {
        document.addEventListener(visibilityChange, function() {
            if (!document[hidden]) {
                checkTimeAndUpdate();
            }
        }, false);
    }
})();
</script>
