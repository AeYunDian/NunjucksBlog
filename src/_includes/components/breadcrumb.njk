{% macro breadcrumb(items) %}
{% if items and items.length %}
<nav class="breadcrumb" aria-label="面包屑">
  <ol class="breadcrumb__list">
    {% for item in items %}
    <li class="breadcrumb__item">
      {% if item.href and not loop.last %}
        <a href="{{ item.href }}">{{ item.text }}</a>
      {% else %}
        <span>{{ item.text }}</span>
      {% endif %}
    </li>
    {% endfor %}
  </ol>
</nav>
{% endif %}
{% endmacro %}