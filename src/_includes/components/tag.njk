{% macro tagList(tags, locale) %}
<div class="tag-list">
  {% for t in tags %}
  <a class="chip" href="{{ '/tags/' | localeUrl(locale) }}{{ t | tagSlug }}/">{{ t }}</a>
  {% endfor %}
</div>
{% endmacro %}

{% macro chip(text, href, count, active) %}
<a class="chip{% if active %} chip--active{% endif %}" href="{{ href }}">{{ text }}{% if count %}<span class="chip__count">{{ count }}</span>{% endif %}</a>
{% endmacro %}

{# 兼容旧签名：{{ tag({ text, href, color, count }) }}（文章正文里用到） #}
{% macro tag(opts) %}
{% set text = opts.text or "" %}
{% set href = opts.href %}
{% set count = opts.count %}
{% if href %}
<a class="chip{% if opts.active %} chip--active{% endif %}" href="{{ href }}">{{ text }}{% if count %}<span class="chip__count">{{ count }}</span>{% endif %}</a>
{% else %}
<span class="chip">{{ text }}{% if count %}<span class="chip__count">{{ count }}</span>{% endif %}</span>
{% endif %}
{% endmacro %}
