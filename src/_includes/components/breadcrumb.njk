{% macro breadcrumb(items, locale) %}
{% if items and items.length %}
<nav class="breadcrumb" aria-label="{{ 'a11y.breadcrumb' | t(locale.id) }}">
  {% for item in items %}
    {% if not loop.last and item.href %}
    <a href="{{ item.href }}">{{ item.text }}</a><span class="breadcrumb__sep" aria-hidden="true">/</span>
    {% else %}
    <span{% if loop.last %} aria-current="page"{% endif %}>{{ item.text }}</span>
    {% endif %}
  {% endfor %}
</nav>
{% endif %}
{% endmacro %}
