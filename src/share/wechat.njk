title: 分享到微信
description: 使用微信扫一扫，把本页分享给好友或分享到朋友圈。
permalink: /share/wechat/
eleventyExcludeFromCollections: true
css:
  - pages/share-wechat
---

<div class="wxshare">
  <h2 class="wxshare__title">分享到微信</h2>

  <div class="wxshare__code" id="wxshare-code"></div>

  <p class="wxshare__tip">
    用微信「扫一扫」，点击右上角分享按钮，<br>
    即可将网页分享给您的微信好友或朋友圈。
  </p>

</div>

{% onlyJS %}
<script src="/assets/vendor/jquery-1.12.4.min.js"></script>
<script src="/assets/vendor/jquery.qrcode.min.js"></script>
<script>
$(function () {
  var ALLOWED = ["undz.cn", "yzhyzxy.cn", "gov.cn", "edu.cn"];

  function isAllowedHost(hostname) {
    hostname = (hostname || "").toLowerCase();
    for (var i = 0; i < ALLOWED.length; i++) {
      var d = ALLOWED[i];
      if (hostname === d || hostname.slice(-(d.length + 1)) === "." + d) {
        return true;
      }
    }
    return false;
  }

  var $codeBox = $("#wxshare-code");

  var m = window.location.search.match(/[?&]url=([^&]*)/);
  var url = m ? decodeURIComponent(m[1]) : "";

  function fail(msg) {
    $codeBox.html('<p class="wxshare__err">' + msg + '</p>');
  }

  if (!/^https?:\/\//i.test(url)) {
    $(".wxshare").remove();
    return;
  }

  var hostname = "";
  try {
    var a = document.createElement("a");
    a.href = url;
    hostname = a.hostname;
  } catch (e) {
    fail("链接格式不正确。");
    return;
  }

  if (!isAllowedHost(hostname)) {
    $(".wxshare").remove();
    return;
  }


  $codeBox.qrcode({
    render: "table",
    width: 200,
    height: 200,
    text: url
  });
});
</script>
{% endonlyJS %}