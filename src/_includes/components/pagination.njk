{% macro paginationNav(pagination, locale) %}
{% if pagination.pages.length > 1 %}
<nav class="pager" aria-label="{{ 'pagination.label' | t(locale.id) }}">
  {% if pagination.href.previous %}
  <a class="pager__link" href="{{ pagination.href.previous }}" rel="prev">‹ {{ 'pagination.prev' | t(locale.id) }}</a>
  {% else %}
  <span class="pager__disabled">‹ {{ 'pagination.prev' | t(locale.id) }}</span>
  {% endif %}

  {% for href in pagination.hrefs %}
    {% if loop.index0 == pagination.pageNumber %}
    <span class="pager__current" aria-current="page">{{ loop.index }}</span>
    {% else %}
    <a class="pager__link" href="{{ href }}">{{ loop.index }}</a>
    {% endif %}
  {% endfor %}

  {% if pagination.href.next %}
  <a class="pager__link" href="{{ pagination.href.next }}" rel="next">{{ 'pagination.next' | t(locale.id) }} ›</a>
  {% else %}
  <span class="pager__disabled">{{ 'pagination.next' | t(locale.id) }} ›</span>
  {% endif %}
</nav>
{% endif %}
{% endmacro %}
