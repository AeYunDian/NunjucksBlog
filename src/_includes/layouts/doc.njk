---
layout: layouts/base.njk
---
{% from "components/breadcrumb.njk" import breadcrumb %}

{% set homeUrl = '/' | localeUrl(locale) %}

<div class="narrow">
  {{ breadcrumb([
    { text: ui.nav.home, href: homeUrl },
    { text: title }
  ], locale) }}

  <article class="doc">
    <header class="doc__header">
      <h1 class="doc__title">{{ title }}</h1>
      {% if updated %}
      <p class="doc__updated">{{ 'doc.updated' | t(locale.id) }}：{{ updated | dateFormat(locale.id) }}</p>
      {% endif %}
    </header>

    <div class="doc__content">
      {{ content | safe }}
    </div>
  </article>

  <script type="application/ld+json">{{ jsonldBreadcrumb([{ name: ui.nav.home, url: site.url + homeUrl }, { name: title, url: site.url + page.url }]) | safe }}</script>
</div>
