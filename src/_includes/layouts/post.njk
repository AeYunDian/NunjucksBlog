---
layout: layouts/base.njk
css:
  - components/tag
  - components/breadcrumb
  - pages/post
---

{% from "components/breadcrumb.njk" import breadcrumb %}
{% from "components/tag.njk" import tagList %}
{% set shareUrl = site.url + page.url %}
{% set shareTitle = title + " - " + site.title %}
{% set shareSummary = description or title %}

{{ breadcrumb([
    { text: "首页", href: "/" },
    { text: "文章", href: "/posts/" },
    { text: title }
]) }}
<article class="post">
  <header class="post__header">
    <h1 class="post__title">{{ title }}</h1>
    {% if date %}
    <time class="post__date" datetime="{{ date | dateFormat }}">{{ date | dateFormat }}</time>
    {% endif %}

    <div class="post__meta">
    {% if tags %}
      <div class="post__tags">
        {{ tagList(tags) }}
      </div>
    {% endif %}
    <div class="share-box">
        <a class="share-btn share_tsina"  target="_blank" rel="noopener" 
            href="https://service.weibo.com/share/share.php?url={{ shareUrl | urlencode }}&title={{ shareTitle | urlencode }}{% if ogImage or site.ogImage %}&pic={{ (site.url + (ogImage or site.ogImage)) | urlencode }}{% endif %}"
        title="新浪微博"></a>

        <a class="share-btn share_weixin"  target="_blank" rel="noopener" 
           href="/share/wechat/?url={{ shareUrl | urlencode }}"
        title="微信"></a>
        <a class="share-btn share_qzone"  target="_blank" rel="noopener" 
            href="https://sns.qzone.qq.com/cgi-bin/qzshare/cgi_qzshare_onekey?url={{ shareUrl | urlencode }}&title={{ shareTitle | urlencode }}&summary={{ shareSummary | urlencode }}{% if ogImage or site.ogImage %}&pics={{ (site.url + (ogImage or site.ogImage)) | urlencode }}{% endif %}"
        title="QQ空间"></a>
      </div>
      </div>
  </header>

  <div class="post__content">
    {{ content | safe }}
  </div>
</article>