<!DOCTYPE html>
<html lang="{{ locale.htmlLang }}">
<head>
  {% include "partials/head.njk" %}
</head>
<body>
  <!--[if lt IE 10]>
  <div class="ie-fallback" lang="{{ locale.htmlLang }}">
    <h1>{{ 'browser.title' | t(locale.id) }}</h1>
    <p>{{ 'browser.desc' | t(locale.id) }}</p>
    <p>{{ 'browser.hint' | t(locale.id) }}</p>
  </div>
  <style>
    #site { display: none !important; }
    .ie-fallback { display: block !important; max-width: 640px; margin: 80px auto; padding: 0 24px; font-family: "Segoe UI", "Microsoft YaHei", sans-serif; color: #1F1F1F; }
    .ie-fallback h1 { font-size: 24px; line-height: 1.4; margin: 0 0 12px; font-weight: 500; }
    .ie-fallback p { font-size: 15px; line-height: 1.75; color: #5F6368; margin: 0 0 8px; }
  </style>
  <![endif]-->

  <div id="site">
    <a class="skip-link" href="#main">{{ ui.footer.skip }}</a>

    {% include "partials/app-bar.njk" %}
    {% include "partials/drawer.njk" %}

    <main class="main" id="main" tabindex="-1">
      <div class="container">
        {{ content | safe }}
      </div>
    </main>

    {% include "partials/footer.njk" %}

    {% from "components/icon.njk" import icon %}
    <button class="fab-top" id="to-top" type="button" aria-label="{{ ui.footer.top }}">
      {{ icon("arrow-up") }}
    </button>
  </div>

  {% include "partials/scripts.njk" %}
</body>
</html>
