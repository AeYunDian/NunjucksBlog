{% macro paginationNav(pagination) %}
{% if pagination.pages.length > 1 %}
<nav class="pagination" aria-label="分页导航">
  {% if pagination.href.previous %}
    <a href="{{ pagination.href.previous }}" class="pagination__link">上一页</a>
  {% else %}
    <span class="pagination__link pagination__link--disabled">上一页</span>
  {% endif %}

  {% for pageUrl in pagination.hrefs %}
    {% set pageNum = loop.index %}
    {% if pageUrl == pagination.page.url %}
      <span class="pagination__link pagination__link--current">{{ pageNum }}</span>
    {% else %}
      <a href="{{ pageUrl }}" class="pagination__link">{{ pageNum }}</a>
    {% endif %}
  {% endfor %}

  {% if pagination.href.next %}
    <a href="{{ pagination.href.next }}" class="pagination__link">下一页</a>
  {% else %}
    <span class="pagination__link pagination__link--disabled">下一页</span>
  {% endif %}
</nav>
{% endif %}
{% endmacro %}