{
    "name": "newblog",
    "version": "2.0.0",
    "description": "韵典综合平台 · Eleventy 静态站点",
    "scripts": {
        "clean": "rimraf dist",
        "predev": "npm run build:aquery",
        "dev": "rimraf dist && cross-env ELEVENTY_ENV=development eleventy --serve",
        "prebuild": "npm run build:aquery",
        "build": "rimraf dist && cross-env ELEVENTY_ENV=production eleventy",
        "prebuild:prod": "npm run build:aquery",
        "build:prod": "rimraf dist && cross-env ELEVENTY_ENV=production eleventy",
        "build:aquery": "node scripts/build-aquery.mjs",
        "verify": "npm run build:prod"
    },
    "browserslist": [
        "ie 10",
        "ie 11",
        "last 2 chrome versions",
        "last 2 firefox versions",
        "last 2 safari versions",
        "last 2 edge versions",
        "ios >= 12",
        "android >= 8"
    ],
    "engines": {
        "node": ">=20"
    },
    "keywords": [],
    "type": "commonjs",
    "devDependencies": {
        "@11ty/eleventy": "^3.1.6",
        "@11ty/eleventy-navigation": "^1.0.5",
        "@11ty/eleventy-plugin-rss": "^3.1.0",
        "@quasibit/eleventy-plugin-sitemap": "^2.2.0",
        "autoprefixer": "^10.6.1",
        "cross-env": "^10.1.0",
        "cssnano": "^7.0.0",
        "html-minifier-terser": "^7.2.0",
        "postcss": "^8.5.28",
        "postcss-custom-properties": "^14.0.0",
        "postcss-import": "^16.0.0",
        "rimraf": "^6.1.3"
    },
    "dependencies": {
        "node-pinyin": "^0.2.3"
    }
}
